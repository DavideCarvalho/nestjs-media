{
  "name": "@dudousxd/nestjs-media-database-typeorm",
  "version": "0.8.0",
  "description": "nestjs-media TypeORM media store",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavideCarvalho/nestjs-media.git",
    "directory": "packages/database-typeorm"
  },
  "homepage": "https://davidecarvalho.github.io/aviary/docs/media",
  "bugs": {
    "url": "https://github.com/DavideCarvalho/nestjs-media/issues"
  },
  "keywords": [
    "nestjs",
    "media",
    "database",
    "typeorm"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./nest": {
      "import": {
        "types": "./dist/nest/index.d.ts",
        "default": "./dist/nest/index.js"
      },
      "require": {
        "types": "./dist/nest/index.d.cts",
        "default": "./dist/nest/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "node ../../scripts/check-package-exports.mjs",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.spec.json --noEmit"
  },
  "peerDependencies": {
    "@dudousxd/nestjs-media-core": ">=0.11.0 <1.0.0",
    "typeorm": "^0.3.0",
    "@nestjs/typeorm": "^11.0.0 || ^12.0.0"
  },
  "devDependencies": {
    "@dudousxd/nestjs-media-core": "workspace:*",
    "@dudousxd/nestjs-media-testing": "workspace:*",
    "better-sqlite3": "12.11.1",
    "mysql2": "3.11.5",
    "pg": "8.23.1",
    "testcontainers": "10.18.0",
    "tsup": "8.5.1",
    "typeorm": "0.3.31",
    "typescript": "5.9.3",
    "@nestjs/typeorm": "12.0.3",
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "peerDependenciesMeta": {
    "@nestjs/typeorm": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  }
}
