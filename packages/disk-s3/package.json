{
  "name": "@dudousxd/nestjs-media-disk-s3",
  "version": "0.8.0",
  "description": "nestjs-media S3 driver (presign + multipart-capable)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavideCarvalho/nestjs-media.git",
    "directory": "packages/disk-s3"
  },
  "homepage": "https://davidecarvalho.github.io/aviary/docs/media",
  "bugs": {
    "url": "https://github.com/DavideCarvalho/nestjs-media/issues"
  },
  "keywords": [
    "nestjs",
    "media",
    "disk",
    "s3"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.spec.json --noEmit"
  },
  "dependencies": {
    "@aws-crypto/sha256-js": "5.2.0",
    "@smithy/protocol-http": "5.3.14",
    "@smithy/signature-v4": "5.3.14"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/s3-request-presigner": "^3.0.0",
    "@dudousxd/nestjs-media-core": ">=0.8.0 <1.0.0"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1131.0",
    "@aws-sdk/s3-request-presigner": "3.1131.0",
    "@dudousxd/nestjs-media-core": "workspace:*",
    "@dudousxd/nestjs-media-testing": "workspace:*",
    "@smithy/util-stream": "3.3.4",
    "aws-sdk-client-mock": "4.1.0",
    "testcontainers": "10.18.0",
    "tsup": "8.5.1",
    "typescript": "5.9.3"
  }
}
