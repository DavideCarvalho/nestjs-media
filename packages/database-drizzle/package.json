{
  "name": "@dudousxd/nestjs-media-database-drizzle",
  "version": "0.6.0",
  "description": "nestjs-media Drizzle media store (sqlite, and Postgres via /pg)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavideCarvalho/nestjs-media.git",
    "directory": "packages/database-drizzle"
  },
  "homepage": "https://davidecarvalho.github.io/aviary/docs/media",
  "bugs": {
    "url": "https://github.com/DavideCarvalho/nestjs-media/issues"
  },
  "keywords": [
    "nestjs",
    "media",
    "database",
    "drizzle",
    "sqlite",
    "postgres"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./pg": {
      "import": {
        "types": "./dist/pg/index.d.ts",
        "default": "./dist/pg/index.js"
      },
      "require": {
        "types": "./dist/pg/index.d.cts",
        "default": "./dist/pg/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.spec.json --noEmit"
  },
  "peerDependencies": {
    "@dudousxd/nestjs-media-core": ">=0.8.0 <1.0.0",
    "drizzle-orm": ">=0.38.0 <1.0.0"
  },
  "devDependencies": {
    "@dudousxd/nestjs-media-core": "workspace:*",
    "@dudousxd/nestjs-media-testing": "workspace:*",
    "@types/better-sqlite3": "7.6.13",
    "@types/pg": "8.11.10",
    "better-sqlite3": "11.10.0",
    "drizzle-orm": "0.45.3",
    "pg": "8.23.0",
    "testcontainers": "10.18.0",
    "tsup": "8.5.1",
    "typescript": "5.9.3"
  },
  "typesVersions": {
    "*": {
      "pg": [
        "./dist/pg/index.d.ts"
      ]
    }
  }
}
