{
  "name": "@dudousxd/nestjs-media-telescope",
  "version": "0.5.11",
  "description": "Telescope watcher for nestjs-media (consumes nestjs:media:* diagnostics)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavideCarvalho/nestjs-media.git",
    "directory": "packages/telescope"
  },
  "homepage": "https://davidecarvalho.github.io/aviary/docs/media",
  "bugs": {
    "url": "https://github.com/DavideCarvalho/nestjs-media/issues"
  },
  "keywords": [
    "nestjs",
    "media",
    "telescope"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.spec.json --noEmit"
  },
  "peerDependencies": {
    "@dudousxd/nestjs-diagnostics": "^0.7.0",
    "@dudousxd/nestjs-media-core": ">=0.8.0 <1.0.0",
    "@dudousxd/nestjs-telescope": "^1.0.0"
  },
  "devDependencies": {
    "@dudousxd/nestjs-diagnostics": "0.7.2",
    "@dudousxd/nestjs-media-core": "workspace:*",
    "@dudousxd/nestjs-telescope": "1.29.1",
    "tsup": "8.3.5",
    "typescript": "5.9.3"
  }
}
